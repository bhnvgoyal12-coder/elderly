<?xml version="1.0" encoding="utf-8"?>
<!--
  Default dimens — sized conservatively for very small phones (smallestWidth < 360dp).
  Larger devices override these via values-sw360dp, values-sw411dp, values-sw600dp,
  and values-sw720dp. Text uses sp so it also respects user font-scale settings.
-->
<resources>
    <!-- Button dimensions -->
    <dimen name="button_height">112dp</dimen>
    <dimen name="button_min_width">112dp</dimen>
    <dimen name="icon_size">40dp</dimen>

    <!-- Auto-size text bounds (label can shrink to min when translated text overflows) -->
    <dimen name="text_button">18sp</dimen>
    <dimen name="text_button_min">12sp</dimen>
    <dimen name="text_header">26sp</dimen>
    <dimen name="text_contact_name">14sp</dimen>
    <dimen name="text_section_header">18sp</dimen>

    <!-- Spacing -->
    <dimen name="spacing_large">16dp</dimen>
    <dimen name="spacing_medium">12dp</dimen>
    <dimen name="spacing_small">6dp</dimen>

    <!-- Contact photo -->
    <dimen name="contact_photo_size">56dp</dimen>

    <!-- Corner radius -->
    <dimen name="button_corner_radius">14dp</dimen>

    <!-- Internal button paddings (icon + text composition) -->
    <dimen name="button_padding_top">14dp</dimen>
    <dimen name="button_padding_bottom">12dp</dimen>
    <dimen name="button_icon_padding">8dp</dimen>
</resources>
